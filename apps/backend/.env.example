# Application
NODE_ENV=development
PORT=5000

# Database (Neon PostgreSQL)
# Copy both strings from the Neon console: Project > Dashboard > Connect.
# Never commit real values; put them in apps/backend/.env (git-ignored).

# Neon pooled connection for application runtime (hostname contains -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15"

# Neon direct connection for Prisma migrations (same host without -pooler)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15"

# Authentication (JWT)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=1d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
