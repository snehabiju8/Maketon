# Application
NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brightloop

# Authentication (JWT)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=1d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
