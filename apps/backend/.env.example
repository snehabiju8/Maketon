# Application
NODE_ENV=development
PORT=5000

# Database (Neon PostgreSQL)
# Application pooled connection
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require
# Direct connection for migrations
DIRECT_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Authentication (JWT)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=1d

# Frontend URL (for CORS and CSRF Origin check)
FRONTEND_URL=http://localhost:5173

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Initial Admin Bootstrap
ADMIN_EMAIL=admin@brightloop.com
ADMIN_PASSWORD=replace_with_secure_admin_password
ADMIN_NAME="System Administrator"
